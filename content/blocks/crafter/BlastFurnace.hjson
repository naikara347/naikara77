name:Blast Furnace
type:GenericCrafter
category:crafting
size:2
description:"Melts metal                 i'll be back"
hasPower:true
hasItems:true
hasLiquids:true
itemCapacity:10
liquidCapacity:100
craftTime:5
//素材
  consumes:{
    power:1.5
    items:{
      items:[
        CopperPowder/5
      ]
    }
  }
//常時アンロック
  outputsLiquid:true
//搬出する液体
  outputLiquid:MoltenCopper/0.25
//建築コスト
  requirements:[
    CopperPowder/80
  ]
//研究
  research:{
    //親
      parent:Corejanaikara
    //研究コスト
      requirements:[
        CopperPowder/800
      ]
  }
